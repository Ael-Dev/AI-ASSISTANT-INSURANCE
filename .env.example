# =============================================================
# AI-ASSISTANT-INSURANCE — Variables de entorno
# Copiar como .env y completar con valores reales
# NUNCA commitear el archivo .env
# =============================================================

# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LangSmith (trazabilidad)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=ai-assistant-insurance
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Vector Store
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION_NAME=insurance_docs

# Memoria
# Opciones: in_memory | sqlite | redis
MEMORY_BACKEND=sqlite
MEMORY_DB_PATH=./data/memory.db
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Seguridad
MAX_INPUT_TOKENS=2000
MAX_OUTPUT_TOKENS=4000
ENABLE_PII_DETECTION=true
ENABLE_PROMPT_INJECTION_CHECK=true
