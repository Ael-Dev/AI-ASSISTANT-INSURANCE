# Copiar como .env y ajustar. Nunca subir el archivo .env

# Modelos por rol. Proveedores: ollama, openrouter, google_genai, xai, anthropic
# Embeddings solo admite: ollama, google_genai, openrouter
LLM_PROVIDER=ollama
LLM_NAME=4skl/gemma4-e2b-mtp:latest
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=512
# Debe estar en false: el thinking consume los tokens de salida
LLM_REASONING=false

# Juez, aún sin uso
# JUDGE_PROVIDER=ollama
# JUDGE_NAME=4skl/gemma4-e2b-mtp:latest
# JUDGE_TEMPERATURE=0

EMBEDDING_PROVIDER=ollama
EMBEDDING_NAME=bge-m3

# Ejemplo con modelos de pago
# LLM_PROVIDER=anthropic
# LLM_NAME=claude-sonnet-5-5

# Llaves. Solo la del proveedor que uses
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Datos
CUSTOMERS_CSV_PATH=data/synthetic/structured/AutoInsurance.csv
RAW_DOCUMENTS_DIRECTORY=data/raw
MARKDOWN_DOCUMENTS_DIRECTORY=data/processed/markdown
SQLITE_DATABASE_PATH=data/processed/crm.db
VECTOR_STORE_DIRECTORY=data/vectorstore
VECTOR_STORE_TABLE_NAME=insurance_documents

# Chunking. Reindexar al cambiarlo
CHUNK_SIZE=1500
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=64

# Recuperación: candidatos por método, pesos y reranking
RETRIEVAL_CANDIDATES_K=6
DENSE_WEIGHT=0.5
BM25_WEIGHT=0.5
RERANK_ENABLED=true
RERANK_MODEL_NAME=jinaai/jina-reranker-v2-base-multilingual
RERANK_TOP_K=5
RERANK_THREADS=4
RERANK_CACHE_DIRECTORY=data/processed/models

# API
API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
