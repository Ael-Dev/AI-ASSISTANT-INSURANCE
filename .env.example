# Copiar como .env. Nunca subir el archivo .env

# Modelos por rol. Proveedores: ollama, openrouter, google_genai, xai, anthropic
# Embeddings solo admite: ollama, google_genai, openrouter
LLM_PROVIDER=ollama
LLM_NAME=qwen3:8b
LLM_TEMPERATURE=0

JUDGE_PROVIDER=ollama
JUDGE_NAME=qwen3:8b
JUDGE_TEMPERATURE=0

EMBEDDING_PROVIDER=ollama
EMBEDDING_NAME=bge-m3

# Ejemplo con modelos de pago
# LLM_PROVIDER=anthropic
# LLM_NAME=claude-sonnet-5-5

# Llaves. Solo la del proveedor que uses
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# Rutas y chunking
SQLITE_DATABASE_PATH=data/processed/crm.db
VECTOR_STORE_DIRECTORY=data/vectorstore
RETRIEVAL_TOP_K=4
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

LOG_LEVEL=INFO
